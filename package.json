{
  "name": "beacons",
  "version": "0.1.0",
  "description": "Pools your Claude accounts behind a small local gateway.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "test": "npm run test:wire && npm run test:engine",
    "test:wire": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "test:engine": "node --test --test-timeout=120000 'test/engine/*.test.js'",
    "test:smoke": "node --experimental-strip-types --no-warnings --test test/smoke.test.ts",
    "test:live": "node --experimental-strip-types --no-warnings --test test/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
